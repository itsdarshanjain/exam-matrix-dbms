# ==============================================================================
# Git Ignore Configuration - ExamMatrix University Exam DBMS (Academic Project)
# ==============================================================================

# 1. Environment & Secrets (STRICT: Never commit real credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
!.env.example

# Subdirectory envs
backend/.env
backend/.env.local
backend/*.env
!backend/.env.example
frontend/.env
frontend/.env.local
frontend/*.env
!frontend/.env.example

# 2. Dependency Directories
node_modules/
backend/node_modules/
frontend/node_modules/

# 3. Production Builds & Bundles
dist/
dist-ssr/
build/
frontend/dist/
*.local

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS & Workspace Specific
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# 6. IDEs & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 7. Temporary / Cache directories
.cache/
.parcel-cache/
.eslintcache
tmp/
temp/
scratch/
